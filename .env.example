# --- Telegram ---
# Create bot with @BotFather, get your numeric ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# --- Anthropic ---
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-4-5-20251001
MODEL_SMART=claude-sonnet-4-6
DAILY_TOKEN_BUDGET=300000

# --- Calendar (CalDAV, read-only in v0) ---
# iCloud: https://caldav.icloud.com  + Apple ID + app-specific password
CALDAV_URL=
CALDAV_USER=
CALDAV_PASS=

# --- Telemetry ingest (iOS Shortcuts -> POST /ingest) ---
INGEST_PORT=8787
INGEST_SECRET=

# --- Schedule ---
TZ=Europe/London
BRIEF_WEEKDAY=07:00
BRIEF_WEEKEND=08:30
QUIET_START_HOUR=22
QUIET_END_HOUR=6

DB_PATH=data/aide.db

# ---- Email (optional) ----
# Use an APP-SPECIFIC PASSWORD, never your account password.
# iCloud:  imap.mail.me.com / smtp.mail.me.com
# Gmail:   imap.gmail.com  / smtp.gmail.com  (needs 2FA + app password)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Comma-separated addresses/domains to flag as important in triage
VIP_SENDERS=
