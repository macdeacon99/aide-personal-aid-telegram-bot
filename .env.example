# --- Telegram ---
# Create bot with @BotFather, get your numeric ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# --- Anthropic ---
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-4-5-20251001
MODEL_SMART=claude-sonnet-4-6
DAILY_TOKEN_BUDGET=500000

# --- Calendar (CalDAV, read-only in v0) ---
# iCloud: https://caldav.icloud.com  + Apple ID + app-specific password
CALDAV_URL=
CALDAV_USER=
CALDAV_PASS=

# --- Telemetry ingest (iOS Shortcuts -> POST /ingest) ---
INGEST_PORT=8787
INGEST_SECRET=

# --- Schedule ---
TZ=Europe/London
BRIEF_WEEKDAY=07:00
BRIEF_WEEKEND=08:30
QUIET_START_HOUR=22
QUIET_END_HOUR=6

DB_PATH=data/aide.db

# ---- Email (optional) ----
# Use an APP-SPECIFIC PASSWORD, never your account password.
# iCloud:  imap.mail.me.com / smtp.mail.me.com
# Gmail:   imap.gmail.com  / smtp.gmail.com  (needs 2FA + app password)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Comma-separated addresses/domains to flag as important in triage
VIP_SENDERS=

# ---- Cost control ----
# Budget is measured in CACHE-WEIGHTED tokens (cache reads count at 0.1x,
# writes at 1.25x), so it tracks real spend rather than raw volume.
# ~200k/day ≈ $20/month on Sonnet 5 at introductory rates.
# Route simple commands ("add X", "done #3") to Haiku
ENABLE_ROUTING=true
# Conversation turns kept in context. Lower = cheaper.
HISTORY_TURNS=6
# The brief is formatting, not reasoning — Haiku handles it
MODEL_BRIEF=claude-haiku-4-5-20251001
